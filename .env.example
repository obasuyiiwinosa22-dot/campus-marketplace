# CampusMarket — environment variables
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

# PostgreSQL connection string from Aiven (use the "URI" shown in your
# Aiven service's "Connection Information" panel).
DATABASE_URL=postgres://username:password@host:port/dbname?sslmode=require

# Auth secret — generate a long random string, e.g.:
#   openssl rand -hex 32
SECRET=change-me-to-a-long-random-string

# Node environment. Set to "production" on Render (enables SSL + prod behavior).
NODE_ENV=production

# Optional bootstrap moderator account. Created on first launch only if BOTH
# ADMIN_EMAIL and ADMIN_PASSWORD are set. Never use a guessable password.
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=change-me
# ADMIN_NAME=Moderator

# Optional transactional email (leave blank to log codes to the console in dev).
# EMAIL_API_URL=
# EMAIL_API_KEY=
